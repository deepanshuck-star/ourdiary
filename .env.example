# ==============================================================================
# OurDiary Environment Variables Template (.env.example)
#
# IMPORTANT SECURITY RULES:
# 1. Do NOT commit real secrets to Git.
# 2. Never prefix CLOUDINARY_API_KEY or CLOUDINARY_API_SECRET with NEXT_PUBLIC_.
# 3. Copy this file to .env.local to configure your real credentials.
# ==============================================================================

# --- SUPABASE CONFIGURATION ---
# Found in: Supabase Dashboard -> Project Settings -> API
# URL of your Supabase Project (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Anon/Publishable API Key (safe for browser, guarded by Row Level Security)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional: Service Role key for administrative scripts/cron (SERVER ONLY, NEVER NEXT_PUBLIC_)
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_SERVER_ONLY


# --- CLOUDINARY CONFIGURATION ---
# Found in: Cloudinary Console -> Dashboard / API Keys
# Cloud Name (safe for browser, used in media URLs)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME

# Cloudinary API Key (SERVER ONLY - NEVER expose to browser)
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY_SERVER_ONLY

# Cloudinary API Secret (SERVER ONLY - NEVER expose to browser)
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET_SERVER_ONLY


# --- APPLICATION URL ---
# Base URL for auth redirects, sitemap, and open graph tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI date planner (/planner). Server-side only — never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=


# --- OPTIONAL: CUSTOM 3D TRAIN SCENE (Journey page, 3D mode) ---
# Public URL of a Spline scene export (Spline -> Export -> Code -> React), e.g.
# https://prod.spline.design/XXXXXXXX/scene.splinecode
# Leave empty to use the built-in low-poly train. Safe for browser (NEXT_PUBLIC_).
NEXT_PUBLIC_SPLINE_TRAIN_SCENE=
